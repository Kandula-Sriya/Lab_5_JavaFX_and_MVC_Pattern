<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane styleClass="root-pane" prefHeight="640.0" prefWidth="560.0"
           stylesheets="@../css/style.css"
           xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.mycompany.lab5.controller.PersonController">

   <VBox styleClass="card" maxWidth="420.0" maxHeight="-Infinity" spacing="6.0" alignment="TOP_LEFT">
      <padding>
         <Insets top="32.0" right="36.0" bottom="32.0" left="36.0"/>
      </padding>

      <Label text="Registration Form" styleClass="title"/>
      <Label text="Please fill in your details below" styleClass="subtitle"/>

      <Region prefHeight="10.0"/>

      <Label text="FULL NAME" styleClass="field-label"/>
      <TextField fx:id="nameField" promptText="e.g. Sriya Kandula"/>
      <Label fx:id="nameError" styleClass="error-label" managed="false" visible="false"/>

      <Region prefHeight="6.0"/>

      <Label text="AGE" styleClass="field-label"/>
      <TextField fx:id="ageField" promptText="e.g. 21"/>
      <Label fx:id="ageError" styleClass="error-label" managed="false" visible="false"/>

      <Region prefHeight="6.0"/>

      <Label text="EMAIL ADDRESS" styleClass="field-label"/>
      <TextField fx:id="emailField" promptText="e.g. name@example.com"/>
      <Label fx:id="emailError" styleClass="error-label" managed="false" visible="false"/>

      <Region prefHeight="18.0"/>

      <HBox spacing="12.0">
         <Button text="Submit" onAction="#handleSubmit" defaultButton="true"
                 styleClass="btn-primary" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
         <Button text="Clear" onAction="#handleClear"
                 styleClass="btn-secondary" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
      </HBox>
   </VBox>
</StackPane>